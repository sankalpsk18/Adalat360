# ADALAT360 Backend Environment Variables

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="8h"

# Encryption
MASTER_ENCRYPTION_KEY="your-32-byte-master-encryption-key-here-32c"

# OpenRouter (for Nemotron 3 Ultra)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Embedding Model (local/free)
EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"
EMBEDDING_API_URL="http://localhost:8000/v1/embeddings"  # Local embedding server

# Server
PORT=3001
NODE_ENV="development"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800  # 50MB

# Rate Limiting
LLM_RATE_LIMIT_RPM=40
LLM_RATE_LIMIT_BURST=10

# CORS
FRONTEND_URL="http://localhost:5173"