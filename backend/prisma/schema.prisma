// Prisma Schema for ADALAT360 (SQLite compatible)
// Tamper-evident custody for legal and investigation records

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums are not supported in SQLite - using String with checks
// Role: IO, PP, REC, CRT, FSL, SYS
// CaseStatus: OPEN, UNDER_INVESTIGATION, CHARGESHEET_FILED, IN_COURT, CLOSED
// PriorityLabel: LOW, MEDIUM, HIGH
// DocumentType: FIR, CHARGE_SHEET, WITNESS_STATEMENT, COURT_FILING, JUDGMENT, LEGAL_NOTICE, PHOTO, VIDEO, AUDIO, FORENSIC_REPORT, DEVICE_EXTRACT
// IntegrityState: VERIFIED, PENDING, MISMATCH
// CustodyAction: UPLOAD, VIEW, EXPORT, VERIFY, REDACT, TRANSFER, SIGN, DOWNLOAD
// SignatureTargetType: DOCUMENT, CERTIFICATE
// ApprovalResourceType: DOCUMENT, CERTIFICATE, CASE, EXHIBIT
// ApprovalStatus: PENDING, APPROVED, REJECTED
// ConflictSeverity: LOW, MEDIUM, HIGH, CRITICAL

model User {
  id              String   @id @default(uuid())
  name            String
  serviceBarId    String   @unique
  passwordHash    String
  role            String   // IO, PP, REC, CRT, FSL, SYS
  department      String
  publicKey       String?
  privateKeyEnc   String?
  status          String   @default("active") // active, suspended
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  uploadedDocuments   Document[]      @relation("DocumentUploader")
  custodyEntries      CustodyEntry[]
  auditLogs           AuditLog[]
  signatures          Signature[]
  redactions          Redaction[]
  certificates        Certificate[]   @relation("CertificateGenerator")
  approvalRequests    ApprovalRequest[] @relation("ApprovalRequester")
  approvalsToReview   ApprovalRequest[] @relation("ApprovalReviewer")
  ragQueryCache       RagQueryCache[]
  assignedCases       Case[]          @relation("CaseOfficers")

  @@map("users")
}

model Case {
  id              String   @id @default(uuid())
  caseNumber      String   @unique
  title           String
  status          String   @default("OPEN") // OPEN, UNDER_INVESTIGATION, CHARGESHEET_FILED, IN_COURT, CLOSED
  department      String
  priorityScore   Int      @default(0)
  priorityLabel   String   @default("LOW") // LOW, MEDIUM, HIGH
  courtDate       DateTime?
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  documents         Document[]
  exhibits          ExhibitEntry[]
  custodyEntries    CustodyEntry[]
  auditLogs         AuditLog[]
  conflictAlerts    ConflictAlert[]
  approvalRequests  ApprovalRequest[]
  certificates      Certificate[]
  ragQueryCache     RagQueryCache[]
  officers          User[]          @relation("CaseOfficers")

  @@map("cases")
}

model Document {
  id               String   @id @default(uuid())
  caseId           String
  filename         String
  version          Int      @default(1)
  parentVersionId  String?
  sha256Hash       String   @unique
  encBlobRef       String   // Path to encrypted file
  encIv            String   // Initialization vector for AES-GCM
  encTag           String   // Authentication tag for AES-GCM
  uploadedBy       String
  uploadedAt       DateTime @default(now())
  locked           Boolean  @default(false)
  docType          String   // FIR, CHARGE_SHEET, WITNESS_STATEMENT, COURT_FILING, JUDGMENT, LEGAL_NOTICE, PHOTO, VIDEO, AUDIO, FORENSIC_REPORT, DEVICE_EXTRACT
  integrity        String   @default("PENDING") // VERIFIED, PENDING, MISMATCH
  restricted       Boolean  @default(false)
  redactedCopy     Boolean  @default(false)
  signed           Boolean  @default(false)
  signedBy         String?
  ocrText          String?
  department       String

  // Relations
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader          User     @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  parentVersion     Document? @relation("DocumentVersions", fields: [parentVersionId], references: [id])
  childVersions     Document[] @relation("DocumentVersions")
  custodyEntries    CustodyEntry[]
  signatures        Signature[]
  redactions        Redaction[]
  certificates      Certificate[]
  exhibits          ExhibitEntry[]
  approvalRequests  ApprovalRequest[]
  ragChunks         RagChunk[]

  @@index([caseId])
  @@index([sha256Hash])
  @@index([uploadedBy])
  @@map("documents")
}

model CustodyEntry {
  id            String   @id @default(uuid())
  documentId    String
  actorId       String
  action        String   // UPLOAD, VIEW, EXPORT, VERIFY, REDACT, TRANSFER, SIGN, DOWNLOAD
  prevEntryHash String?
  entryHash     String
  timestamp     DateTime @default(now())
  notes         String?
  caseId        String
  broken        Boolean  @default(false)

  // Relations
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor         User     @relation(fields: [actorId], references: [id])
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([actorId])
  @@index([caseId])
  @@index([timestamp])
  @@map("custody_entries")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String
  timestamp    DateTime @default(now())
  ip           String?
  metadata     String?  // JSON string

  // Relations
  actor        User     @relation(fields: [actorId], references: [id])
  case         Case?    @relation(fields: [caseId], references: [id])
  caseId       String?

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

model ExhibitEntry {
  id          String   @id @default(uuid())
  caseId      String
  documentId  String?
  exhibitCode String   @unique
  label       String
  category    String   // WEAPON, VEHICLE, CASH, DEVICE, DOCUMENT, BIOLOGICAL
  status      String   // IN_MALKHANA, WITH_FSL, IN_COURT, IN_TRANSIT, RELEASED
  location    String
  holder      String
  sealHash    String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  // Relations
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id])

  @@index([caseId])
  @@map("exhibit_entries")
}

model Redaction {
  id            String   @id @default(uuid())
  documentId    String
  regionsJson   String   // JSON array of redaction regions
  redactedBy    String
  reason        String
  createdAt     DateTime @default(now())

  // Relations
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor         User     @relation(fields: [redactedBy], references: [id])

  @@index([documentId])
  @@map("redactions")
}

model Certificate {
  id            String   @id @default(uuid())
  documentId    String
  caseId        String
  generatedBy   String
  certText      String
  hashSummary   String
  issuedAt      DateTime @default(now())

  // Relations
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  generator     User     @relation("CertificateGenerator", fields: [generatedBy], references: [id])

  @@index([documentId])
  @@index([caseId])
  @@map("certificates")
}

model Signature {
  id              String   @id @default(uuid())
  userId          String
  targetType      String   // DOCUMENT, CERTIFICATE
  targetId        String
  signatureValue  String
  publicKeyRef    String
  signedAt        DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id])
  document        Document? @relation(fields: [targetId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("signatures")
}

model ConflictAlert {
  id            String   @id @default(uuid())
  caseId        String
  documentIds   String   // JSON array of document IDs
  description   String
  severity      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?

  // Relations
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([resolved])
  @@map("conflict_alerts")
}

model ApprovalRequest {
  id              String   @id @default(uuid())
  resourceType    String   // DOCUMENT, CERTIFICATE, CASE, EXHIBIT
  resourceId      String
  requestedBy     String
  approverRole    String   // IO, PP, REC, CRT, FSL, SYS
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  decidedAt       DateTime?
  decidedBy       String?

  // Relations
  requester       User     @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  reviewer        User?    @relation("ApprovalReviewer", fields: [decidedBy], references: [id])
  case            Case?    @relation(fields: [caseId], references: [id])
  caseId          String?
  document        Document? @relation(fields: [resourceId], references: [id])

  @@index([resourceType, resourceId])
  @@index([approverRole, status])
  @@map("approval_requests")
}

model RagChunk {
  id          String   @id @default(uuid())
  documentId  String
  chunkIndex  Int
  content     String
  embedding   String   // JSON string of float array
  createdAt   DateTime @default(now())

  // Relations
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("rag_chunks")
}

model RagQueryCache {
  id                String   @id @default(uuid())
  caseId            String
  questionNormalized String  @unique
  answerJson        String
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  // Relations
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])
  userId            String

  @@index([caseId])
  @@index([expiresAt])
  @@map("rag_query_cache")
}